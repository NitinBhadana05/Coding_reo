#Maximum Difference (Order matters)

def difference(numbers: list[int]) -> int:
    
    if len(numbers) < 2:
        return 0

    min_so_far = numbers[0]
    max_diff = 0

    for i in range(1, len(numbers)):
        current_diff = numbers[i] - min_so_far

        if current_diff > max_diff:
            max_diff = current_diff

        if numbers[i] < min_so_far:
            min_so_far = numbers[i]

    return max_diff
    
#example

numbers = [1, 2, 3, 4, 5]
print(difference(numbers))

output:
4
